/target
.claude/

# Generated egregore stores and graph snapshots
*.jsonl
!tests/fixtures/**/*.jsonl
# Checked-in evaluation corpora (seeds for reproducible recall metrics)
!corpus/*.jsonl
# GitHub importer idempotency state (operator-local, never committed)
.github-import-state.json
# Ignore all .egregore* directories (runtime data, caches, variant stores)
# then carve out the tasks directory so project JSONL files can be tracked.
.egregore*/
!.egregore/
.egregore/*
!.egregore/tasks/
.egregore/tasks/*
!.egregore/tasks/*.jsonl
