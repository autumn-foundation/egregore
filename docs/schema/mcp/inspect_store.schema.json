{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Structured store-inspection summary (issue #194).",
  "properties": {
    "diagnostics": {
      "type": "integer"
    },
    "domain_counts": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "type": "object"
    },
    "edges": {
      "type": "integer"
    },
    "freshness": {
      "additionalProperties": true,
      "properties": {
        "current_dirty": {
          "type": "boolean"
        },
        "current_head": {
          "additionalProperties": true,
          "properties": {
            "sha": {
              "type": "string"
            },
            "state": {
              "enum": [
                "commit",
                "no_git",
                "unborn_head"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        "fresh": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "repo_path": {
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "stored_snapshot": {
          "anyOf": [
            {
              "additionalProperties": true,
              "properties": {
                "dirty": {
                  "type": "boolean"
                },
                "head": {
                  "additionalProperties": true,
                  "properties": {
                    "sha": {
                      "type": "string"
                    },
                    "state": {
                      "enum": [
                        "commit",
                        "no_git",
                        "unborn_head"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "type": "object"
                },
                "repository_id": {
                  "type": "string"
                },
                "scanned_at": {
                  "type": "string"
                }
              },
              "required": [
                "head",
                "dirty",
                "repository_id",
                "scanned_at"
              ],
              "type": "object"
            },
            {
              "description": "Explicit marker for a pre-stamping store — never a silent absence, never a false `fresh`.",
              "properties": {
                "state": {
                  "const": "pre_stamping"
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            }
          ]
        },
        "verdict": {
          "enum": [
            "fresh",
            "stale_head",
            "stale_dirty",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "fresh",
        "repository_id",
        "repo_path",
        "stored_snapshot",
        "current_head",
        "current_dirty",
        "message"
      ],
      "type": "object"
    },
    "nodes": {
      "type": "integer"
    },
    "ok": {
      "const": true
    },
    "records": {
      "type": "integer"
    },
    "repositories": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "identity_summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "identity_summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_versions": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    "snapshot_timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "tombstones": {
      "type": "integer"
    },
    "unknown_schema_versions": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    }
  },
  "required": [
    "ok",
    "records",
    "nodes",
    "edges",
    "tombstones",
    "diagnostics",
    "domain_counts",
    "schema_versions",
    "unknown_schema_versions",
    "repositories",
    "freshness"
  ],
  "title": "Egregore MCP tool response: inspect_store",
  "type": "object"
}
